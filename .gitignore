# Dataset files and generated CSVs stay local; keep the folder structure in Git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
